<!-- where user enters ingredients -->
<p>Enter the ingredients you have and any dietary needs.</p>

<!-- input form -->
<form id="ingredient-form" method="POST" action="/generate_recipe">

    <!-- box to type ingredients -->
    <label for="ingredients" class="form-label">Ingredients</label>

    <textarea
        id="ingredients"
        name="ingredients"
        class="form-control"
        rows="4"
        required
    ></textarea>

    <!-- button to send ingredients -->
    <input
        id="submit-button"
        type="submit"
        class="btn btn-primary mt-3"
        value="Submit"
    >

</form>